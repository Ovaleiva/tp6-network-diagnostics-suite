<?xml version="1.0" encoding="utf-8"?>
<!--
  Release: HTTP sin cifrar solo hacia la PC del laboratorio. 10.0.2.2 es la PC
  vista desde el emulador; 127.0.0.1 y localhost sirven en un teléfono físico
  con `adb reverse tcp:3000 tcp:3000`. Cualquier otro backend debe usar HTTPS.
  SNMP (UDP) y SSH no pasan por esta política.
  La compilación debug la reemplaza (src/debug) porque Metro usa HTTP.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
</network-security-config>
