{
  "name": "NetworkDiagnosticsSuite",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "node scripts/android.cjs run",
    "ios": "react-native run-ios",
    "lint": "eslint App.tsx index.js src __tests__ scripts *.config.js jest.setup.js --ext .js,.ts,.tsx,.cjs",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check App.tsx src __tests__ scripts",
    "bundle:android": "node scripts/bundle-android.cjs",
    "doctor:android": "node scripts/android.cjs doctor",
    "verify": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run bundle:android",
    "android:env": "node scripts/android.cjs env",
    "lab:snmp": "node scripts/snmp-lab.cjs",
    "test:snmp-lab": "node --test scripts/snmp-lab.test.cjs"
  },
  "codegenConfig": {
    "name": "NetworkDiscoverySpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.networkdiagnosticssuite"
    }
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.41.0",
    "@op-engineering/op-sqlite": "^19.0.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "^4.0.0",
    "react-native-vision-camera": "^5.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
